{
  "title": "Iris API",
  "uid": "iris-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requêtes par seconde (par endpoint)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (handler) (rate(http_requests_total[1m]))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latence p95 (secondes)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{handler}}" }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Prédictions par espèce",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (species) (iris_predictions_total)", "legendFormat": "{{species}}", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erreurs (4xx/5xx) sur 5 min",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(http_requests_total{status=~\"4xx|5xx\"}[5m]))" }
      ]
    }
  ]
}
